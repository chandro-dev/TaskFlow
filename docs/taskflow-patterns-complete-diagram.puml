package "Next.App Entrypoints" #FFFFFF {
  class "app/(workspace)/reports/page.tsx" as ReportsPage <<Page>>
  class "app/api/reports/route.ts" as ReportsApi <<RouteHandler>>
  class "app/api/projects/.../tasks/route.ts" as TasksApi <<RouteHandler>>
