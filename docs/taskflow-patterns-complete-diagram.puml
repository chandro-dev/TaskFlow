package "Application.Services" #F7F7F7 {
  class SnapshotLoader {
    -repository: IRepositroyFlow
    +load(): Promise<TaskflowSnapshot>
  }

  class ProjectQueryService
  class ProjectCommandService {
    -repository: IRepositroyFlow
    -notificationPublisher: ProjectEventPublisher
    +createProject(input: CreateProjectInput, ownerId: string): Promise<CreateProjectResult>
    +updateProject(input: UpdateProjectInput, actorId: string): Promise<Project>
  }

  class ProjectCloneService {
    -repository: IRepositroyFlow
    -notificationPublisher: ProjectEventPublisher
    +cloneProject(input: CloneProjectRequestInput): Promise<CloneProjectResult>
  }

  class BoardCommandService {
    -repository: IRepositroyFlow
    -notificationPublisher: ProjectEventPublisher
    +createBoard(input: CreateBoardInput, actorId: string): Promise<Board>
  }

  class TaskCommandService {
    -repository: IRepositroyFlow
    -notificationPublisher: ProjectEventPublisher
    +createTask(input: CreateTaskInput): Promise<Task>
  }

  class TaskUpdateService
  class TaskMoveService
  class TaskDeleteService
  class TaskCloneService
  class InvitationQueryService
  class InvitationCommandService {
    -repository: IRepositroyFlow
    -notificationPublisher: ProjectEventPublisher
    +createInvitation(input: CreateInvitationInput): Promise<MemberInvitation>
    +acceptInvitation(token: string): Promise<MemberInvitation>
  }
  class NotificationQueryService
  class NotificationCommandService
  class WorkspaceQueryService
  class SettingsCommandService
  class ThemePreferenceCommandService
  class AuthCommandService
  class AuthQueryService
  class SessionCommandService
}

