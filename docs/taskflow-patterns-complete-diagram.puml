    +deleteTask(input: DeleteTaskInput): Promise<void>
    +moveTask(input: MoveTaskInput): Promise<Task>
    +cloneTask(input: CloneTaskRequestInput): Promise<Task>
    +getBoardPageData(projectId: string, boardId: string, filters: TaskFilters, currentUser?: UserProfile): Promise<BoardPageView?>
    +getProjectsPageData(search, currentUser?): Promise<ProjectsPageView>
    +getBoardsPageData(currentUser?: UserProfile): Promise<BoardsPageView>
    +getSettingsPageData(): Promise<SettingsView>
