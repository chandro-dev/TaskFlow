    - repository: IRepositroyFlow
    - snapshotLoader: SnapshotLoader
    +cloneTask(input: CloneTaskRequestInput): Promise<Task>
    - buildClonedSubtasks(sourceSubtasks: Subtask[], input: CloneTaskRequestInput): { source: Subtask; clone: Subtask }[]
  }
