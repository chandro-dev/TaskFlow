}

' Domain model relations
Project "1" *-- "*" Board
Board "1" *-- "*" BoardColumn
Project "1" *-- "*" Task
Task "1" *-- "*" Subtask
Task "1" o-- "*" Label
Task "1" o-- "*" TaskComment
Task "1" o-- "*" TaskAttachment
Task "1" o-- "*" TaskHistoryEntry
Project "1" o-- "*" ProjectMember
BoardTaskView --|> Task
BoardColumnView --|> BoardColumn
BoardColumnView *-- "*" BoardTaskView
BoardPageView *-- Project
BoardPageView *-- Board
BoardPageView *-- "*" BoardColumnView
ProjectCardView ..> Project
ProjectMemberView ..> ProjectMember
ProjectNotificationView --|> ProjectNotification
NotificationCenterView *-- "*" ProjectNotificationView
SettingsView *-- SystemSettings
ProjectInvitationView --|> MemberInvitation
Project "1" *-- "*" MemberInvitation
Project "1" *-- "*" ProjectNotification
UserProfile "1" -- "*" Project : owner/member >
UserProfile "1" -- "*" Task : assignee >
TaskflowSnapshot *-- UserProfile
TaskflowSnapshot *-- SystemSettings
TaskflowSnapshot *-- Project
TaskflowSnapshot *-- ProjectMember
TaskflowSnapshot *-- Board
TaskflowSnapshot *-- Task
TaskflowSnapshot *-- MemberInvitation
TaskflowSnapshot *-- ProjectNotification

