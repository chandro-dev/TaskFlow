package "Patterns.Structural.Composite" #EFFFF7 {
  interface WorkItemComponent <<Composite>> {
    +id: string
    +title: string
    +completedUnits(): number
    +totalUnits(): number
    +progress(): number
  }

  class TaskComposite <<Composite>> {
    -task: Task
    -children: WorkItemComponent[]
    +completedUnits(): number
    +totalUnits(): number
    +progress(): number
  }

  class SubtaskLeaf <<Leaf>> {
    -subtask: Subtask
    +completedUnits(): number
    +totalUnits(): number
    +progress(): number
  }
}

package "Patterns.Structural.Decorator" #EFFFF7 {
  class BoardTaskDecorator <<Decorator>> {
    -task: Task
    -snapshot: TaskflowSnapshot
    +decorate(): BoardTaskView
  }
}

package "Patterns.Structural.Proxy" #EFFFF7 {
  class RouteAuthorizationProxy <<Proxy>> {
    -accessPolicy: ProjectAccessPolicy
    +requireAdmin(user: UserProfile): UserProfile
    +requireProjectMember(project: Project, user: UserProfile): UserProfile
    +requireProjectManager(project: Project, user: UserProfile): UserProfile
    +requireProjectCoordinator(project: Project, user: UserProfile): Promise<UserProfile>
  }
}

package "Patterns.Structural.Adapter" #EFFFF7 {
  class NotificationEventAdapter <<Adapter>> {
    +toNotificationInputs(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): CreateProjectNotificationInput[]
  }

  class SupabaseTaskflowRepository <<Adapter>>
  class MockTaskflowRepository <<Adapter>>
}

package "Patterns.Structural.Bridge" #EFFFF7 {
  class ReportQueryService <<BridgeAbstraction>> {
    -repository: IRepositroyFlow
    +getWorkspaceReport(currentUser?: UserProfile): Promise<WorkspaceReportView>
    +renderWorkspaceReport(format: ReportFormat, currentUser?: UserProfile): Promise<RenderedReport>
  }

  interface ReportRenderer <<BridgeImplementor>> {
    +contentType: string
    +extension: string
    +render(document: ReportDocument): string
  }

  class HtmlReportRenderer <<ConcreteImplementor>>
  class CsvReportRenderer <<ConcreteImplementor>>
  class JsonReportRenderer <<ConcreteImplementor>>
  class ReportDocument <<DTO>>
  class WorkspaceReportView <<ViewModel>>
  class RenderedReport <<DTO>>
}

