' ==========================================================
' DOMAIN RELATIONSHIPS
' ==========================================================

Project "1" *-- "*" Board : owns
Board "1" *-- "*" BoardColumn : columns
Project "1" *-- "*" Task : contains
Task "1" *-- "*" Subtask : composite data
Task "1" o-- "*" Label : labels
Task "1" o-- "*" TaskComment : comments
Task "1" o-- "*" TaskAttachment : attachments
Task "1" o-- "*" TaskHistoryEntry : history
Project "1" o-- "*" ProjectMember : memberships
Project "1" *-- "*" MemberInvitation : invitations
Project "1" *-- "*" ProjectNotification : notifications
TaskflowSnapshot *-- UserProfile
TaskflowSnapshot *-- Project
TaskflowSnapshot *-- ProjectMember
TaskflowSnapshot *-- Board
TaskflowSnapshot *-- Task
TaskflowSnapshot *-- MemberInvitation
TaskflowSnapshot *-- ProjectNotification
TaskflowSnapshot *-- SystemSettings

BoardTaskView --|> Task
BoardColumnView --|> BoardColumn
BoardColumnView *-- "*" BoardTaskView
BoardPageView *-- Project
BoardPageView *-- Board
BoardPageView *-- "*" BoardColumnView
ProjectCardView ..> Project
ProjectMemberView ..> ProjectMember
BoardsPageView *-- "*" ProjectCardView
SettingsView *-- SystemSettings
NotificationCenterView *-- "*" ProjectNotificationView
ProjectNotificationView --|> ProjectNotification
ProjectInvitationView --|> MemberInvitation

' ==========================================================
' PATTERN IMPLEMENTATION RELATIONSHIPS
' ==========================================================

' Singleton
MockTaskflowRepository o--> MockTaskflowStore : uses single store
ThemeSingleton ..> ThemeArtifacts : applies visual family

' Abstract Factory
LightThemeFactory ..|> ThemeFactory
DarkThemeFactory ..|> ThemeFactory
ThemeFactory ..> ThemePalette : creates
ThemeFactory ..> ThemeArtifacts : feeds

' Factory Method
BugTaskFactory --|> TaskFactory
FeatureTaskFactory --|> TaskFactory
ImprovementTaskFactory --|> TaskFactory
StandardTaskFactory --|> TaskFactory
TaskFactory ..> Task : creates

DefaultKanbanBoardFactory --|> BoardFactory
BoardFactory ..> Board
BoardFactory ..> BoardColumn

DeveloperProfileFactory --|> UserProfileFactory
UserProfileFactory ..> UserProfile

InAppInvitationFactory --|> InvitationFactory
InvitationFactory ..> MemberInvitation

BaseNotificationComposer ..|> NotificationComposer
ProjectCreatedNotificationComposer --|> BaseNotificationComposer
ProjectUpdatedNotificationComposer --|> BaseNotificationComposer
BoardCreatedNotificationComposer --|> BaseNotificationComposer
TaskCreatedNotificationComposer --|> BaseNotificationComposer
MemberInvitedNotificationComposer --|> BaseNotificationComposer
MemberJoinedNotificationComposer --|> BaseNotificationComposer
NotificationComposer ..> ProjectNotificationEvent
NotificationComposer ..> CreateProjectNotificationInput

' Builder
UserRegistrationBuilder ..> UserProfile : normalized input
ProjectBuilder ..> Project : builds
TaskBuilder ..> Task : builds
TaskUpdateBuilder ..> Task : rebuilds
MemberInvitationBuilder ..> MemberInvitation : builds
ProjectNotificationBuilder ..> ProjectNotification : builds

' Prototype
TaskPrototype ..> Task : clones
SubtaskPrototype ..> Subtask : clones
ProjectPrototype ..> Project : clones
BoardPrototype ..> Board : clones
BoardColumnPrototype ..> BoardColumn : clones
InvitationPrototype ..> MemberInvitation : clones

' Facade
TaskflowService o--> ProjectQueryService
TaskflowService o--> ProjectCommandService
TaskflowService o--> ProjectCloneService
TaskflowService o--> BoardCommandService
TaskflowService o--> TaskCommandService
TaskflowService o--> TaskUpdateService
TaskflowService o--> TaskMoveService
TaskflowService o--> TaskDeleteService
TaskflowService o--> TaskCloneService
TaskflowService o--> InvitationCommandService
TaskflowService o--> InvitationQueryService
TaskflowService o--> NotificationQueryService
TaskflowService o--> NotificationCommandService
TaskflowService o--> ReportQueryService
TaskflowService o--> AuthCommandService
TaskflowService o--> AuthQueryService
TaskflowService o--> SessionCommandService
TaskflowService o--> WorkspaceQueryService
TaskflowService o--> SettingsCommandService
TaskflowService o--> ThemePreferenceCommandService

' Composite
TaskComposite ..|> WorkItemComponent
SubtaskLeaf ..|> WorkItemComponent
TaskComposite *-- "*" WorkItemComponent : children
TaskComposite o--> Task
SubtaskLeaf o--> Subtask

' Decorator
BoardTaskDecorator o--> Task
BoardTaskDecorator o--> TaskflowSnapshot
BoardTaskDecorator ..> BoardTaskView : decorates into
BoardTaskDecorator ..> TaskComposite : uses progress
TaskCard ..> BoardTaskView : renders decorated task

' Proxy
RouteAuthorizationProxy o--> ProjectAccessPolicy
RouteAuthorizationProxy ..> UserProfile
RouteAuthorizationProxy ..> Project
TasksApi ..> RouteAuthorizationProxy : checks access before use case

' Adapter
SupabaseTaskflowRepository ..|> IRepositroyFlow
MockTaskflowRepository ..|> IRepositroyFlow
NotificationEventAdapter ..> NotificationComposer : adapts composer output
NotificationEventAdapter ..> CreateProjectNotificationInput
ProjectNotificationSubscriber o--> NotificationEventAdapter

' Bridge
