@startuml
title Taskflow - Participantes Exhaustivos de Patrones

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam wrapWidth 220
skinparam maxMessageSize 180
hide empty members

legend right
  Version exhaustiva para anexo tecnico.
  Incluye implementadores directos del patron,
  colaboradores del flujo y tipos de soporte.
endlegend

package "Domain.Contracts" {
  interface IRepositroyFlow <<port>> {
    +loadSnapshot(): Promise<TaskflowSnapshot>
    +findUserById(userId: string): Promise<UserProfile | null>
    +findUserByEmail(email: string): Promise<UserProfile | null>
    +registerUser(input: RegisterUserInput): Promise<RegisterUserResult>
    +createProject(input: CreateProjectInput): Promise<CreateProjectResult>
    +cloneProject(input: CloneProjectInput): Promise<CloneProjectResult>
    +updateProject(input: UpdateProjectInput): Promise<Project>
    +deleteProject(projectId: string): Promise<void>
    +removeProjectMember(projectId: string, memberId: string): Promise<Project>
    +updateProjectMemberRole(projectId: string, memberId: string, memberRole: UserProfile["role"]): Promise<Project>
    +createBoard(input: CreateBoardInput): Promise<Board>
    +createBoardColumn(input: CreateBoardColumnInput): Promise<Board>
    +updateBoardColumn(input: UpdateBoardColumnInput): Promise<Board>
    +reorderBoardColumns(input: ReorderBoardColumnsInput): Promise<Board>
    +deleteBoardColumn(input: DeleteBoardColumnInput): Promise<Board>
    +createTask(input: CreateTaskInput): Promise<Task>
    +updateTask(input: UpdateTaskInput): Promise<Task>
    +deleteTask(input: { taskId: string; projectId: string; boardId: string }): Promise<void>
    +cloneTask(input: CloneTaskInput): Promise<Task>
    +moveTask(input: MoveTaskInput): Promise<Task>
    +createNotifications(input: CreateProjectNotificationInput[]): Promise<ProjectNotification[]>
    +markNotificationRead(notificationId: string, recipientId: string): Promise<ProjectNotification>
    +markAllNotificationsRead(recipientId: string): Promise<void>
    +clearNotifications(recipientId: string): Promise<void>
    +updateSettings(input: UpdateSystemSettingsInput): Promise<SystemSettings>
    +updateUserThemePreference(userId: string, mode: ThemeMode): Promise<UserProfile>
    +createInvitation(input: CreateInvitationInput): Promise<MemberInvitation>
    +updateInvitationStatus(input: UpdateInvitationStatusInput): Promise<MemberInvitation>
    +resendInvitation(invitationId: string): Promise<MemberInvitation>
    +findInvitationByToken(token: string): Promise<MemberInvitation | null>
  }
  interface TaskflowAuthProvider <<port>> {
    +authenticateWithPassword(input: PasswordAuthInput): Promise<AuthenticationResult>
  }
  class ProjectAccessPolicy {
    +canManage(project: Project, user: UserProfile): boolean
    +canAccess(project: Project, user: UserProfile): boolean
  }
}

package "Domain.Entities" {
  class UserProfile <<entity>> {
    id: string
    name: string
    email: string
    role: UserRole
    avatar: string
    bio: string
    lastAccess: string
    themePreference: ThemeMode
    isActive: boolean
  }
  class Project <<entity>> {
    id: string
    name: string
    description: string
    startDate: string
    endDate: string
    state: ProjectState
    archived: boolean
    memberIds: string[]
    ownerId: string
    boardIds: string[]
  }
  class Board <<entity>> {
    id: string
    projectId: string
    name: string
    columns: BoardColumn[]
  }
  class BoardColumn <<entity>> {
    id: string
    boardId: string
    name: string
    order: number
    color: string
    wipLimit: number?
  }
  class Task <<entity>> {
    id: string
    projectId: string
    boardId: string
    columnId: string
    title: string
    description: string
    priority: TaskPriority
    type: TaskType
    dueDate: string
    estimateHours: number
    spentHours: number
    clonedFromTaskId: string?
    labels: Label[]
    assigneeIds: string[]
    subtasks: Subtask[]
    comments: TaskComment[]
    attachments: TaskAttachment[]
    history: TaskHistoryEntry[]
  }
  class Subtask <<entity>> {
    id: string
    title: string
    isCompleted: boolean
  }
  class MemberInvitation <<entity>> {
    id: string
    projectId: string
    invitedUserId: string
    role: UserRole
    status: InvitationStatus
    channel: InvitationChannel
    invitedBy: string
    token: string
    message: string?
    expiresAt: string
    acceptedAt: string?
    createdAt: string
    updatedAt: string
  }
  class ProjectNotification <<entity>> {
    id: string
    projectId: string
    recipientId: string
    actorId: string?
    boardId: string?
    taskId: string?
    kind: NotificationKind
    title: string
    message: string
    linkHref: string
    isRead: boolean
    readAt: string?
    createdAt: string
  }
  class TaskflowSnapshot <<entity>> {
    currentUser: UserProfile
    users: UserProfile[]
    settings: SystemSettings
    projects: Project[]
    projectMembers: ProjectMember[]
    boards: Board[]
    tasks: Task[]
    invitations: MemberInvitation[]
    notifications: ProjectNotification[]
  }
  class SystemSettings <<entity>> {
    platformName: string
    maxAttachmentMb: number
    passwordPolicy: string
    defaultTheme: ThemeMode
  }
}

package "Domain.Support" {
  interface PasswordAuthInput <<dto>> {
    email: string
    password: string
  }
  interface AuthenticationResult <<dto>> {
    user: UserProfile
    accessToken: string?
    refreshToken: string?
    accessTokenExpiresAt: string?
  }
  interface ProjectNotificationEvent <<event>> {
    kind: NotificationKind
    projectId: string
    actorId: string
    boardId: string?
    taskId: string?
  }
  interface CreateProjectNotificationInput <<dto>> {
    projectId: string
    recipientId: string
    actorId: string?
    boardId: string?
    taskId: string?
    kind: NotificationKind
    title: string
    message: string
    linkHref: string
  }
}

package "Shared" {
  class HttpError {
    statusCode: number
  }
  class UnauthorizedRouteError {
  }
}

package "Patterns.Singleton" {
  class ThemeSingleton <<Singleton>> {
    - instance: ThemeSingleton?
    - listeners: Set<ThemeListener>
    - mediaQuery: MediaQueryList?
    - systemListener: (() => void)?
    - mode: ThemeMode
    - effectiveMode: ResolvedThemeMode
    - initialized: boolean
    - ThemeSingleton()
    + getInstance(): ThemeSingleton
    + initialize(defaultMode: ThemeMode): ThemeSnapshot
    + getMode(): ThemeMode
    + getEffectiveMode(): ResolvedThemeMode
    + getSnapshot(): ThemeSnapshot
    + setMode(nextMode: ThemeMode): void
    + subscribe(listener: ThemeListener): () => void
  }
  class MockTaskflowStore <<Singleton>> {
    - instance: MockTaskflowStore?
    - snapshot: TaskflowSnapshot
    - constructor()
    + getInstance(): MockTaskflowStore
    + loadSnapshot(): TaskflowSnapshot
    + registerUser(input: RegisterUserInput): RegisterUserResult
    + createProject(input: CreateProjectInput): CreateProjectResult
    + cloneProject(input: CloneProjectInput): CloneProjectResult
    + createBoard(input: CreateBoardInput): Board
    + createTask(input: CreateTaskInput): Task
    + updateTask(input: UpdateTaskInput): Task
    + createInvitation(input: CreateInvitationInput): MemberInvitation
  }
}

package "Patterns.AbstractFactory" {
  interface ThemeFactory <<AbstractFactory>> {
    +createPalette(): ThemePalette
  }
  interface ThemePalette <<product>> {
    background: string
    backgroundAccent: string
    surface: string
    surfaceMuted: string
    border: string
    textPrimary: string
    textSecondary: string
    accent: string
    accentStrong: string
    success: string
    warning: string
    danger: string
    avatarGradient: string
  }
  interface ThemeArtifacts <<product>> {
    palette: ThemePalette
    cssVariables: Record<string, string>
  }
  class LightThemeFactory <<ConcreteFactory>> {
    +createPalette(): ThemePalette
  }
  class DarkThemeFactory <<ConcreteFactory>> {
    +createPalette(): ThemePalette
  }
}

package "Patterns.Builder" {
  class UserRegistrationBuilder <<Builder>> {
    - draft: RegisterUserInput
    + normalize(): this
    + validate(): this
    + build(): RegisterUserInput
  }
  class ProjectBuilder <<Builder>> {
    - draft: CreateProjectInput
    + normalize(): this
    + validate(): this
    + buildProject(id: string): Project
  }
  class TaskBuilder <<Builder>> {
    - draft: Task
    + withLabel(label: Label): this
    + withAssignee(userId: string): this
    + withSubtask(title: string, isCompleted?: boolean): this
    + withHistory(entry: TaskHistoryEntry): this
    + build(): Task
  }
  class TaskUpdateBuilder <<Builder>> {
    - draft: Task
    - existingSubtaskIds: Set<string>
    + withCoreFields(fields: UpdateTaskInput): this
    + withAssignees(assigneeIds: string[]): this
    + withSubtasks(subtasks: TaskSubtaskInput[]): this
    + build(): Task
  }
  class MemberInvitationBuilder <<Builder>> {
    - draft: MemberInvitation
    + withMessage(message?: string): this
    + withExpiry(days: number): this
    + asPending(): this
    + asAccepted(): this
    + asRevoked(): this
    + refreshToken(): this
    + build(): MemberInvitation
  }
  class ProjectNotificationBuilder <<Builder>> {
    - draft: CreateProjectNotificationInput
    - readAt: string?
    - isRead: boolean
    + normalize(): this
    + asRead(readAt?: string): this
    + build(id: string, createdAt?: string): ProjectNotification
  }
}

package "Patterns.FactoryMethod" {
  interface TaskFactoryInput <<support>> {
    id: string
    projectId: string
    boardId: string
    columnId: string
    title: string
    description: string
    dueDate: string
    estimateHours: number
    spentHours: number?
    priority: TaskPriority?
  }
  abstract class TaskFactory <<FactoryMethod>> {
    +create(input: TaskFactoryInput): Task
    #createTask(input: TaskFactoryInput, priority: TaskPriority): Task
    #defaultPriority(): TaskPriority
  }
  class BugTaskFactory <<ConcreteFactory>>
  class FeatureTaskFactory <<ConcreteFactory>>
  class ImprovementTaskFactory <<ConcreteFactory>>
  class StandardTaskFactory <<ConcreteFactory>>

  interface BoardFactoryResult <<support>> {
    board: Board
    columns: BoardColumn[]
  }
  abstract class BoardFactory <<FactoryMethod>> {
    +create(projectId: string, name?: string, columnDrafts?: BoardColumnDraftInput[]): BoardFactoryResult
    #boardName(name?: string): string
    #createColumns(boardId: string, columnDrafts?: BoardColumnDraftInput[]): BoardColumn[]
  }
  class DefaultKanbanBoardFactory <<ConcreteFactory>> {
    - defaultColumns: BoardColumnDraftInput[]
    #boardName(name?: string): string
    #createColumns(boardId: string, columnDrafts?: BoardColumnDraftInput[]): BoardColumn[]
  }

  abstract class UserProfileFactory <<FactoryMethod>> {
    +create(input: RegisterUserInput): UserProfile
    #role(): UserRole
    #defaultBio(name: string): string
  }
  class DeveloperProfileFactory <<ConcreteFactory>>

  interface InvitationSeed <<support>> {
    id: string?
    token: string?
    status: InvitationStatus?
    expiresAt: string?
  }
  abstract class InvitationFactory <<FactoryMethod>> {
    +create(seed: InvitationSeed): MemberInvitation
    #channel(): InvitationChannel
    #buildToken(): string
    #defaultExpiry(): string
    #normalizeRole(role: UserRole): UserRole
  }
  class InAppInvitationFactory <<ConcreteFactory>>

  interface NotificationComposer <<FactoryProduct>> {
    +compose(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): CreateProjectNotificationInput[]
  }
  abstract class BaseNotificationComposer {
    #getProjectMembers(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): string[]
    #getProjectName(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): string
    #getBoardName(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): string
    #getTaskTitle(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): string
    #recipientsExcludingActor(event: ProjectNotificationEvent, snapshot: TaskflowSnapshot): string[]
    #buildNotifications(recipients: string[], event: ProjectNotificationEvent, title: string, message: string, linkHref: string): CreateProjectNotificationInput[]
  }
  class ProjectCreatedNotificationComposer
  class ProjectUpdatedNotificationComposer
  class BoardCreatedNotificationComposer
  class TaskCreatedNotificationComposer
  class MemberInvitedNotificationComposer
  class MemberJoinedNotificationComposer
}

package "Patterns.Prototype" {
  class TaskPrototype <<Prototype>> {
    - source: Task
    + clone(overrides?: Partial<Task>): Task
  }
  class SubtaskPrototype <<Prototype>> {
    - source: Subtask
    + clone(overrides?: Partial<Subtask>): Subtask
  }
  class ProjectPrototype <<Prototype>> {
    - source: Project
    + clone(overrides?: Partial<Project>): Project
  }
  class BoardPrototype <<Prototype>> {
    - source: Board
    + clone(overrides?: Partial<Board>): Board
  }
  class BoardColumnPrototype <<Prototype>> {
    - source: BoardColumn
    + clone(overrides?: Partial<BoardColumn>): BoardColumn
  }
  class InvitationPrototype <<Prototype>> {
    - source: MemberInvitation
    + clone(overrides?: Partial<MemberInvitation>): MemberInvitation
  }
}

package "Patterns.Observer" {
  interface ProjectEventSubscriber <<Observer>> {
    +handle(event: ProjectNotificationEvent): Promise<void>
  }
  class ProjectEventPublisher <<Subject>> {
    - subscribers: ProjectEventSubscriber[]
    +publish(event: ProjectNotificationEvent): Promise<void>
  }
  class ProjectNotificationSubscriber <<ConcreteObserver>> {
    - snapshotLoader: SnapshotLoader
    +handle(event: ProjectNotificationEvent): Promise<void>
    - deduplicate(notifications: CreateProjectNotificationInput[]): CreateProjectNotificationInput[]
  }
}

package "Application.Auth" {
  class AuthQueryService {
    - repository: IRepositroyFlow
  }
  class AuthCommandService {
    - repository: IRepositroyFlow
    +registerUser(input: RegisterUserInput): Promise<RegisterUserResult>
  }
  class SessionCommandService {
    - authProvider: TaskflowAuthProvider
    +login(input: PasswordAuthInput): Promise<AuthenticationResult>
  }
}

